        """
        {params.gatk} --java-options "-Xmx4g" HaplotypeCaller -R {params.ref} -I {input.bqsr} -O {output.known} -L chr{wildcards.chr} -ERC GVCF --sample-name {wildcards.sample} > {log} 2>&1
