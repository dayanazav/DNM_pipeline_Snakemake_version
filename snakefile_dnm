###################
# Mapping FASTQ reads into a BAM file
###################

rule fastq:
    input:
        fastq1 = config["DOWNLOAD_FILES"]["FASTQ1"],
        fastq2 = config["DOWNLOAD_FILES"]["FASTQ2"],
    output:
        "{folder}/bams/{sample}.bam",
    envmodules: 
        config['SAMTOOLS'],
    params:
        ref = REF_GENOME,
        seqtk = SEQTK,
        oldBwa = OLDBWA,
        samblaster = SAMBLASTER,
        R = lambda wildcards, input: "@RG\tID:{sample}\tSM:{sample}\tPL:ILLUMINA\tLB:{sample}\tPI:2000" 
    log: 
        "{folder}/log/bams/{sample}_bam.log"
    benchmark:
        "{folder}/bams/benchmarks/{sample}_bam.benchmark.tsv"
    message:
        """
        {params.seqtk} mergepe {input.fastq1} {input.fastq2} | {params.oldBwa} mem -t 20 -R \"{params.R}\" {params.ref} - | {params.samblaster} | samtools view -bS - > {output} 2> {log}
        """
    shell:
        """
        {params.seqtk} mergepe {input.fastq1} {input.fastq2} | {params.oldBwa} mem -t 20 -R \"{params.R}\" {params.ref} - | {params.samblaster} | samtools view -bS - > {output} 2> {log}
        """

###################
# BAMs sort and index
###################

rule sort_index:
    input:
        bam = "{folder}/bams/{sample}.bam"
    output:
        sort = "{folder}/bams/sort_{sample}.bam",
        bai = "{folder}/bams/sort_{sample}.bam.bai"
    envmodules:
       config['SAMTOOLS']
    log:
        "{folder}/log/bams/sort_index_{sample}.log"
    benchmark:
        "{folder}/bams/benchmarks/sort_index_{sample}.benchmark.tsv"
    shell:
        """
        samtools sort -@ 10 -o {output.sort} {input.bam} 2>> {log} | samtools index {output.bai} 2>> {log}
        """

###################
# QC2: depth for all samples
###################

rule qc2_coverage_estimation:
    input:
        bam = "{folder}/bams/sort_{sample}.bam",
        bai = "{folder}/bams/sort_{sample}.bam.bai",
    output:
        gz = "{folder}/QC2/{sample}_coverage.txt.gz",
        gwide = "{folder}/QC2/{sample}_gwide_coverage.txt",
    envmodules:
        config['SAMTOOLS']
    params:
        coverage = lambda wildcards: config['Coverage'][wildcards.sample]
    log:
        "{folder}/log/QC2/{sample}_QC2.log"
    benchmark:
        "{folder}/QC2/benchmarks/{sample}_QC2.benchmark.tsv"
    shell:
        """
        samtools depth {input.bam} | gzip > {output.gz} ; zcat {output.gz} 2>> {log} | awk '{{sum+=$3;}} END {{print \"Average = \" sum/NR}}' > {output.gwide} 2>> {log}
        depth_coverage = $(awk '/Average/ {{print $NF}}' {output.gwide})
        coverage_max = $({params.coverage}+5)
        coverage_min = $({params.coverage}-5)

        if [[ $coverage_max -ge $depth_coverage && $coverage_min -le $depth_coverage ]]; then
             echo "{wildcards.sample} passed with a coverage of $depth_coverage." >&2
        else
             echo "Error in {rule}: {wildcards.sample} DID NOT pass with a coverage of $depth_coverage." >&2
             echo "Next Steps are to redo the alignment for {wildcards.sample}" >&2
             echo "How? Consider which rule from download, fastq, or sort_index should be deleted and rerun." >&2
             echo "Example Details: First, deletes all files generated from sort_index & qc2_coverage_estimation. Lastly, reruns at sort_index." >&2
             echo "Example Command: snakemake --delete-output sort_index --delete-output qc2_coverage_estimation --forcerun sort_index" >&2
             exit 1
        fi
        """

###################
# GATK to create the known variant files
# Based on the father, mother, child, and grandchild
###################

rule unknown_HaplotypeCaller:
    input:
        nonbqsr = "{folder}/bams/sort_{sample}.bam", #editted
        Qc2 = expand("{folder}/QC2/{sample}_gwide_coverage.txt", folder=FOLDER, sample=SAMPLES)
    output:
        new = "{folder}/unknown_HaplotypeCaller/nonbqsr_{sample}_chr{chr}.g.vcf.gz"
    envmodules:
        config['JAVA']
    params:
        gatk = GATK,
        ref = REF_GENOME
    #resources:
        #runtime = # 8 days, 11 hours    
    log:
        "{folder}/log/unknown_HaplotypeCaller/unknown_haplotypeCaller_{sample}_chr{chr}.log"
    benchmark:
        "{folder}/unknown_HaplotypeCaller/benchmarks/{chr}.{sample}.benchmark.tsv"
    shell:
        """
        {params.gatk} --java-options "-Xmx4g" HaplotypeCaller -R {params.ref} -I {input.nonbqsr} -O {output.new} -L chr{wildcards.chr} -ERC GVCF --sample-name {wildcards.sample} > {log} 2>&1
        """

rule unknown_CombinedGVCFs:
    input:
        nonbqsr = expand("{folder}/unknown_HaplotypeCaller/nonbqsr_{sample}_chr{{chr}}.g.vcf.gz", folder=FOLDER, sample=SAMPLES),
    output:
        "{folder}/unknown_CombinedGVCF/unknown_group_chr{chr}.g.vcf"
    envmodules:
        config['JAVA']
    params:
        gatk = GATK,
        ref = REF_GENOME,
        edit = lambda wildcards, input: ' --variant '.join(input.nonbqsr)
    log:
        "{folder}/log/unknown_CombinedGVCF/unknown_combinedGVCF_chr{chr}.log"
    benchmark:
        "{folder}/unknown_CombinedGVCF/benchmarks/{chr}.unknown_CombineGVCFs.benchmark.tsv"
    message:
        """
        {params.gatk} --java-options "-Xmx10g" CombineGVCFs -R {params.ref} --variant {params.edit} -L chr{wildcards.chr} -O {output} > {log} 2>&1
        """
    shell:
        """
        {params.gatk} --java-options "-Xmx10g" CombineGVCFs -R {params.ref} --variant {params.edit} -L chr{wildcards.chr} -O {output} > {log} 2>&1
        """

rule unknown_GenotypeGVCFs:
    input:
        group = "{folder}/unknown_CombinedGVCF/unknown_group_chr{chr}.g.vcf"
    output:
        "{folder}/unknown_GenotypeGVCF/unknown_variants_chr{chr}.g.vcf"
    envmodules:
        config['JAVA']
    params:
        gatk = GATK,
        ref = REF_GENOME
    log:
        "{folder}/log/unknown_GenotypeGVCF/unknown_genotypeGVCF_chr{chr}.log"   
    benchmark:
        "{folder}/unknown_GenotypeGVCF/benchmarks/{chr}.benchmark.tsv"
    shell:
        """
        {params.gatk} --java-options "-Xmx4g" GenotypeGVCFs -R {params.ref} -V {input.group} -L chr{wildcards.chr} -O {output} > {log} 2>&1
        """

###################
# Creating a pedigree table
# required for mendelian_errors when selecting variants 
###################

rule make_pedigree:
    output: 
        "{folder}/{species}_{child}_pedigree.ped"
    params:
        father = config["SAMPLES"]["father"]["name"],
        mother = config["SAMPLES"]["mother"]["name"],
        child = config["SAMPLES"]["child"]["name"],
        f2 = config["SAMPLES"]["f2"]["name"],
        child_gender = config["SAMPLES"]["child"]["gender"],
    log:
        "{folder}/log/make_pedigree/{species}_{child}_pedigree.log",
    benchmark:
        "{folder}/make_pedigree/benchmarks/{species}.{child}.ped.benchmark.tsv",
    shell:
        """
        child_gender="{params.child_gender}"
        if [[ ${{child_gender,,}} = "male" ]]; then
             gender='1'
             echo "Child's gender: $gender" >&2
        elif [[ ${{child_gender,,}} = "female" ]]; then
             gender='2'
             echo "Child's gender: $gender" >&2
        elif [[ ${{child_gender,,}} = "*" ]]; then
             gender='*'
             echo "Child's gender: $gender" >&2
        else
             echo "Error in Rule {rule}: In the YAML file, child's gender is ${{child_gender,,}}, but it should be either male, female, or *" >&2
             exit 1
        fi

        awk -v OFS='\t' -v g="$gender" -v c="{params.child}" -v f="{params.father}" -v m="{params.mother}" -v f2="{params.f2}" \
            'BEGIN {{ print g, c, f, m, g, f2}}' > {output} 2> {log}
        """

###################
# Filtering for high-quality known variants
###################

rule mendelian_errors:
    input:
        vcf = "{folder}/unknown_GenotypeGVCF/unknown_variants_chr{chr}.g.vcf",
        ped = expand("{folder}/{species}_{child}_ped.ped", folder=FOLDER, species=species, child=OFFSPRING_NAME)
    output:
        mend = "{folder}/vio_mend/violations_mendelian_chr{chr}.vcf"
    envmodules:
        config['JAVA']
    params:
        gatk = GATK,
        ref = REF_GENOME,
    log:
        "{folder}/log/vio_mend/VMend_chr{chr}.log"
    benchmark:
        "{folder}/vio_mend/benchmarks/{chr}.benchmark.tsv"
    shell:
        """
        {params.gatk} --java-options "-Xmx10g" SelectVariants -R {params.ref} -V {input.vcf} -ped {params.ped} --mendelian-violation --mendelian-violation-qual-threshold 50 -O {output.mend} -L chr{wildcards.chr} > {log} 2>&1 
        """

rule GATK_filters:    
    input:
        vcf = "{folder}/unknown_GenotypeGVCF/unknown_variants_chr{chr}.g.vcf"
    output:
        out = "{folder}/GATKfilters/All_sites_GATKfilter_chr{chr}.vcf"
    params:
        gatk = GATK,
        ref = REF_GENOME
    log:
        "{folder}/log/GATKfilters/GATK_filters_chr{chr}.log"
    benchmark:
        "{folder}/GATKfilters/benchmarks/GATK_filters_chr{chr}.benchmark.tsv"
    shell:
        """
        {params.gatk} VariantFiltration -R {params.ref} -V {input.vcf} --filter-expression "QD < 2.0 || FS > 60.0 || MQ < 40.0 || MQRankSum < -12.5 || ReadPosRankSum < -8.0 || SOR > 3.0" --filter-name "my_snp_filter" -L chr{wildcards.chr} -O {output.out} > {log} 2>&1
        """

# description: Saving positions with a quality score at or over 50 #before was over 100
rule QUAL:
    input:
        "{folder}/GATKfilters/All_sites_GATKfilter_chr{chr}.vcf"
    output:
        "{folder}/GATKfilters/All_sites_GATKfilter_QUAL_chr{chr}.vcf"
    envmodules:
        config['BCFTOOLS']
    log:
        "{folder}/log/GATKfilters/QUAL_chr{chr}.log"
    benchmark:
        "{folder}/GATKfilters/benchmarks/QUAL_chr{chr}.benchmark.tsv"
    shell:
        """
        bcftools view -i "QUAL>=50" {input} -o {output} -O v > {log} 2>&1
        """

# description: Genetype Quaility (GQ) has a score greater than 40 because will mean 99.999% accuray
rule GQ:
    input:
        qual = "{folder}/GATKfilters/All_sites_GATKfilter_QUAL_chr{chr}.vcf",
    output:
        GQ = "{folder}/GATKfilters/All_sites_GATKfilter_QUAL_GQ_chr{chr}.vcf",
    params:
        gatk = GATK,
        ref = REF_GENOME,
        edit = " && ".join([f"vc.getGenotype(\"{name}\").getGQ()>40" for name in SAMPLES]),
    log:
        "{folder}/log/GATKfilters/GQ_chr{chr}.log",
    benchmark:
        "{folder}/GATKfilters/benchmarks/GQ_chr{chr}.benchmark.tsv"
    message:
        """
        {params.gatk} SelectVariants -R {params.ref} -V {input.qual} --restrict-alleles-to BIALLELIC -select \'{params.edit}\' -O {output.GQ} > {log} 2>&1
        """
    shell:
        """
        {params.gatk} SelectVariants -R {params.ref} -V {input.qual} --restrict-alleles-to BIALLELIC -select \'{params.edit}\' -O {output.GQ} > {log} 2>&1
        """


#description: removed positions from All_sites_GATKfilter_QUAL_GQ_chr{chr}.vcf if they were also in violations_mendelian_chr{chr}.vcf
rule known_variants:
    input:
        GQ = "{folder}/GATKfilters/All_sites_GATKfilter_QUAL_GQ_chr{chr}.vcf",
        mend = "{folder}/vio_mend/violations_mendelian_chr{chr}.vcf",
    output:
        sites = "{folder}/known_variants/known_variants_chr{chr}.vcf",
    envmodules:
        config['BEDTOOLS'],
    log:
        "{folder}/log/known_variants/known_variants_chr{chr}.log",
    benchmark:
        "{folder}/known_variants/benchmarks/known_variants_chr{chr}.benchmark.tsv",
    shell:
        """
        bedtools intersect -header -a {input.mend} -b {input.GQ} > {output.sites} 2> {log}
        """

###################
# Prepare VCF for BQSR
# BQSR requires vcf.gz files
###################

rule bgzip_index:
    input:
        "{folder}/known_variants/known_variants_chr{chr}.vcf",
    output:
        compress = "{folder}/known_variants/known_variants_chr{chr}.vcf.gz",
        index = "{folder}/known_variants/known_variants_chr{chr}.vcf.gz.tbi"
    params:
        bgzip = BGZIP,
        tabix = TABIX,
    log:
        "{folder}/log/known_variants/variants_compress_index_chr{chr}.log"
    shell:
        """
        {params.bgzip} -c {input} > {output.compress} 2>> {log} | {params.tabix} -p vcf {output.compress} 2>> {log}
        """

