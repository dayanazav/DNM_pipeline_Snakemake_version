    params:
        gatk = GATK,
        ref = REF_GENOME,
    log: 
        "{folder}/log/BaseRecal/grand/recal_1_{sample}_chr{chr}.log"
    benchmark:
        "{folder}/BaseRecal/benchmarks/grand/{chr}.{sample}.recal1.benchmark.tsv"
    shell:
        """
        {params.gatk} BaseRecalibrator -R {params.ref} -I {input.bam} --known-sites {input.sites} -O {output.recal1} -L chr{wildcards.chr} > {log} 2>&1
        """

