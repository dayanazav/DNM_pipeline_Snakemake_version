        "{folder}/CombineGVCFs/group_chr{chr}.g.vcf"
    envmodules:
        config['JAVA']
    params:
        gatk = GATK,
        ref = REF_GENOME,
        edit = lambda wildcards, input: ' --variant '.join(input.bqsr)
    log:
        "{folder}/log/CombineGVCFs/CombineGVCFs_chr{chr}.log"
    benchmark:
        "{folder}/CombineGVCFs/benchmarks/{chr}.CombinedGVCFs.benchmark.tsv"
    resources:
        time = "8-00:00:00",
        mem_mb = 300 * 1000 # convert from mb to gb by times 1000 
    message:
        """
        {params.gatk} --java-options "-Xmx10g" CombineGVCFs -R {params.ref} --variant {params.edit} -L chr{wildcards.chr} -O {output} > {log} 2>&1
        """
    shell:
        """
        {params.gatk} --java-options "-Xmx10g" CombineGVCFs -R {params.ref} --variant {params.edit} -L chr{wildcards.chr} -O {output} > {log} 2>&1
        """


