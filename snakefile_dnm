# QC3: BQSR 
###################

rule qc3_analyze_BQSR:
    input:
        recal1 = "{folder}/BaseRecal/{sample}_chr{chr}_recal_1.table",
        recal2 = "{folder}/BaseRecal/{sample}_chr{chr}_recal_2.table"
    output:
        pdf = "{folder}/QC3/{sample}_plots_chr{chr}.pdf"
    envmodules:
        config['R'],
    params:
        gatk = GATK,
    log:
        "{folder}/log/QC3/QC3_{sample}_chr{chr}.log"
    benchmark:
        "{folder}/QC3/benchmarks/{chr}.{sample}.QC3.benchmark.tsv"
    shell:
