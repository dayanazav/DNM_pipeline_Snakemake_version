# De Novo Mutations
###################

rule DNM_Filters:
    input:
        filter_python = config["DNM_FILTERS"],
        vcf = "{folder}/GenotypeGVCFs/variants_group_chr{chr}.g.vcf",
        #sites = KNOWN_SITES,
        sites = "{folder}/known_variants/known_variants_chr{chr}.vcf",
        # KEEP HERE, SO SNAKEMAKE KNOWS TO GENERATE THESE FILE FROM THE RULE(extract)
        DP_files = expand("{folder}/QC2/{sample}_gwide_coverage.txt", folder=FOLDER, sample=SAMPLES),
        # the files to extract the depth number
        child_file=expand("{folder}/QC2/{sample}_gwide_coverage.txt", folder=FOLDER, sample=config["SAMPLES"]["child"]["name"]),
        mother_file=expand("{folder}/QC2/{sample}_gwide_coverage.txt", folder=FOLDER, sample=config["SAMPLES"]["mother"]["name"]),
        father_file=expand("{folder}/QC2/{sample}_gwide_coverage.txt", folder=FOLDER, sample=config["SAMPLES"]["father"]["name"]),
    output:
        "{folder}/DNM/{offspring}_check_dnm_count_chr{chr}.txt"
    envmodules:
        config['PYTHON']
    params:
        final_path = FOLDER,
        # extracting the samples' names
        father = config["SAMPLES"]["father"]["name"],
        mother = config["SAMPLES"]["mother"]["name"],
        child = config["SAMPLES"]["child"]["name"],
        f2 = config["SAMPLES"]["f2"]["name"],
    log:
        "{folder}/log/DNM/{offspring}_check_chr{chr}.log"
    benchmark:
        "{folder}/DNM/benchmarks/{chr}.{offspring}.benchmark.tsv"
    message:
        """
        output_file="{params.final_path}/DNM/{params.child}_check"
        father_DP=$(awk '/Average/ {{print $NF}}' {input.father_file})
        mother_DP=$(awk '/Average/ {{print $NF}}' {input.mother_file})
        child_DP=$(awk '/Average/ {{print $NF}}' {input.child_file})
        echo "Child DP = $child_DP"
        echo "Father DP = $father_DP"
        echo "Mother DP = $mother_DP"
        python {input.filter_python} --mother {params.mother} --father {params.father} --child {params.child} --f2 {params.f2} --vcf {input.vcf} --chr {wildcards.chr} --known_var {input.sites} --output $output_file --child_DP $child_DP --mother_DP $mother_DP --father_DP $father_DP > {log} 2>&1
        """
    shell:
        """
        output_file="{params.final_path}/DNM/{params.child}_check"
        father_DP=$(awk '/Average/ {{print $NF}}' {input.father_file})
        mother_DP=$(awk '/Average/ {{print $NF}}' {input.mother_file})
        child_DP=$(awk '/Average/ {{print $NF}}' {input.child_file})
        echo "Child DP = $child_DP"
        echo "Father DP = $father_DP"
        echo "Mother DP = $mother_DP"
        python {input.filter_python} --mother {params.mother} --father {params.father} --child {params.child} --f2 {params.f2} --vcf {input.vcf} --chr {wildcards.chr} --known_var {input.sites} --output $output_file --child_DP $child_DP --mother_DP $mother_DP --father_DP $father_DP > {log} 2>&1
        """

